# --- Judge LLM ---
ANTHROPIC_API_KEY=your_key_here
JUDGE_MODEL=claude-sonnet-4-6
JUDGE_VOTES=3
JUDGE_TEMPERATURE=0.0

# --- Your voice bot SDK (Houndify) ---
HOUNDIFY_CLIENT_ID=your_client_id_here
HOUNDIFY_CLIENT_KEY=your_client_key_here
HOUNDIFY_ENDPOINT=https://api.houndify.com/
HOUNDIFY_REQUEST_INFO_PATH=vendor/houndify/requestInfo.json
HOUNDIFY_LANG=0

# --- Run settings ---
MAX_CONCURRENT_WORKERS=5
REQUEST_TIMEOUT_SECONDS=30
LATENCY_SLA_MS=3000
PASS_SCORE_THRESHOLD=80
